{
  "name": "diary-word-battle",
  "version": "0.9.1",
  "description": "그림일기 단어 조립 전투 — a picture-diary sentence-combat roguelite",
  "type": "module",
  "scripts": {
    "assets:optimize": "tsx scripts/optimize-assets.ts",
    "assets:check": "tsx scripts/optimize-assets.ts --check",
    "resources:check": "tsx src/tools/resource-lifecycle-check.ts",
    "bundle:check": "tsx scripts/check-bundle-budget.ts",
    "predev": "npm run assets:optimize",
    "prebuild": "npm run assets:optimize",
    "data:generate": "tsx scripts/generate-sentence-data.ts",
    "clip:beats": "tsx scripts/clip-beats.ts",
    "sprites:bake": "node scripts/bake-slash-sprites.mjs",
    "dev": "npm run data:generate && vite",
    "build": "npm run data:generate && npm run assets:check && npm run resources:check && tsc && vite build && npm run bundle:check",
    "preview": "vite preview",
    "type-check": "npm run data:generate && tsc --noEmit",
    "sweep": "npm run data:generate && tsx src/tools/sweep.ts",
    "locale:check": "npm run data:generate && tsx src/tools/locale-check.ts",
    "check": "npm run data:generate && tsx src/tools/check-tables.ts",
    "effects:check": "npm run data:generate && tsx src/tools/combat-effects-check.ts",
    "core:check": "npm run data:generate && tsx src/tools/core-contract-check.ts",
    "balance:check": "npm run data:generate && tsx src/tools/run-sim.ts --runs=8 --check",
    "boss:sim": "npm run data:generate && tsx src/tools/boss-sim.ts",
    "run:sim": "npm run data:generate && tsx src/tools/run-sim.ts",
    "test": "npm run type-check && npm run sweep && npm run check && npm run locale:check && npm run effects:check && npm run core:check && npm run mind:check && npm run boss:sim && npm run balance:check",
    "mind:check": "npm run data:generate && tsx src/tools/token-mind-check.ts"
  },
  "devDependencies": {
    "@types/howler": "^2.2.13",
    "@types/node": "^26.1.1",
    "@types/three": "^0.179.0",
    "playwright-core": "^1.61.1",
    "sharp": "^0.34.5",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "howler": "^2.2.4",
    "three": "^0.179.1"
  }
}
